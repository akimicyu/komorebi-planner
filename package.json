{
  "name": "komorebi-planner",
  "version": "0.1.0",
  "private": true,
  "description": "こもれび計画 — 小さなチームのためのローカルファーストなガントチャート",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node tests/core.cjs",
    "check": "npm run format:check && node --check src/app.js && npm test && npm run build",
    "format": "prettier --write src scripts tests package.json .prettierrc.json",
    "format:check": "prettier --check src scripts tests package.json .prettierrc.json"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
